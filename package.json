{
  "name": "kiwibyte-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Landing page statique de KIWIBYTE Studio (vidéos publicitaires courtes produites avec l'I.A.).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "node --test tests/simulator.test.ts",
    "check:csp": "node scripts/csp-test.mjs",
    "check:visual": "node scripts/shoot.mjs",
    "media": "python scripts/make_media.py && python scripts/make_og.py",
    "fonts": "python scripts/make_fonts.py"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "lenis": "1.3.27",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/three": "0.186.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
